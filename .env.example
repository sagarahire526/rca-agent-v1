# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
MODEL_NAME=gpt-5-mini

# ── Neo4j Knowledge Graph ─────────────────────────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=nokia-v-one

# ── PostgreSQL ────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=bkg_agent
PG_USER=postgres
PG_PASSWORD=

# ── API authentication (REQUIRED) ─────────────────────────────────────────
# HTTP Basic credentials guarding every /api/v1 route. There is no default:
# if either is unset the API returns 401 for every request.
#   curl -u "$API_USERNAME:$API_PASSWORD" https://<host>/api/v1/health
API_USERNAME=
API_PASSWORD=

# ── Environment / exposure ────────────────────────────────────────────────
# "production", "prod" or "staging" disables /docs, /redoc and /openapi.json
# and stops exception text from reaching clients. Anything else = development.
ENV=development

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Empty means no cross-origin browser access at all.
ALLOWED_ORIGINS=

# Origins allowed to embed GET /api/v1/chart/{id}/view in an iframe.
# Defaults to ALLOWED_ORIGINS when unset.
CHART_FRAME_ANCESTORS=

# ── Streamlit dev UI ──────────────────────────────────────────────────────
API_BASE=http://localhost:8001/api/v1

DEBUG=false
